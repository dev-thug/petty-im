# DATABASE_URL is not needed by the landing page (former signup service retired).

# Optional: country header supplied by your reverse proxy/CDN.
# Standard Vercel, CloudFront and Cloudflare country headers work automatically.
# COUNTRY_HEADER=x-country-code

# Optional: show only verified store listings. Web app works without these.
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/...
# NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=...
